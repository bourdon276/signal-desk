APP_ENV=local
DATABASE_URL=postgresql+psycopg://information:replace-this-local-password@127.0.0.1:5432/information_dev
TIMEZONE=Asia/Shanghai
POSTGRES_USER=information
POSTGRES_PASSWORD=replace-this-local-password
POSTGRES_DB=information_dev
APP_SECRET=replace-with-a-long-random-secret-before-deployment
ADMIN_TOKEN=replace-with-a-long-random-admin-token
REGISTRATION_CODE=
CORS_ORIGINS=http://localhost:5173
APP_DOMAIN=example.com
SYNC_IN_WEB=false

# Optional official stock announcement API; disabled without both settings.
# Configure secrets privately in Render Environment, never in Git or chat.
CNINFO_ACCESS_TOKEN=
CNINFO_DISPLAY_ALLOWED=false
CNINFO_DAILY_REQUEST_LIMIT=24

# Optional PandaScore fixture API; free fixture plan requires a private bearer token.
PANDASCORE_TOKEN=

# Optional local Steam networking; production defaults to a direct connection.
STEAM_USE_ENV_PROXY=false
